# ARCHON 2.0 Environment Configuration Template
# Copy this file to .env and configure for your environment.
# Note: ARCHON operates 100% offline with an in-memory graph fallback if Neo4j is not configured.

# Neo4j Graph Database Configuration (Optional - leave default for in-memory fallback)
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-secure-password>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=<your-instance-id>
AURA_INSTANCENAME=ARCHON-Memory-Graph

# Django Settings (Development Defaults)
DJANGO_SECRET_KEY=django-insecure-archon-dev-key-change-in-production
DJANGO_DEBUG=True
